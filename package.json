{
  "type": "module",
  "name": "andrea-garzoglio-portfolio",
  "version": "1.0.0",
  "description": "Andrea Garzoglio's portfolio: art, code and résumé, in English and Italian",
  "main": "index.js",
  "scripts": {
    "build": "webpack",
    "dev": "webpack serve --mode development",
    "lint": "eslint src/",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.1.0",
    "globals": "^15.12.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "3.8.1",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
